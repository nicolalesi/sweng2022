<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:gwt = 'urn:import:com.google.gwt.user.client.ui'
	xmlns:g="urn:import:com.google.gwt.user.client.ui">
	<ui:style>
		
		
		form {
		    margin-bottom: 4vh;
		    margin-left: 30vw;
		    width: 30vw;
		}
		
		.form-group {
		    margin-bottom: 1rem;
		    text-align:center;
		}
		#login{
			margin-bottom:10vh;
		}
	</ui:style>
	<g:HTMLPanel>
	<div id="container">
		<ul id="navbar">
	       <li  id="Home">
	       	<gwt:Button ui:field = "btnHome" text="Home"
                 />
	       </li>
	       <li  id="Dipa">
	       	<gwt:Button ui:field = "btnDip" text="Dipartimenti"
                 />
	       </li>
	        <li  id="Contatti">
	       	<gwt:Button ui:field = "btnContatti" text="Contatti"
                 />
	       </li>
	        <li  id="login">
	       	<gwt:Button ui:field = "btnLogin" text="Login"
                   />
	       </li>

	    </ul>
	    
		<form>
		  <div class="form-group">
		  <h1 id="login"> Accedi </h1>
		    <label for="exampleInputEmail1">Email address</label>
		    <gwt:TextBox ui:field="txtMail"></gwt:TextBox>
		  </div>
		  <div class="form-group">
		    <label for="exampleInputPassword1">Password</label>
		    <gwt:PasswordTextBox ui:field="txtPassword"></gwt:PasswordTextBox>
		  </div>
		 
		  <gwt:Button ui:field="btnSubmit" text="Submit"></gwt:Button>
		</form>
		</div>
	</g:HTMLPanel>
</ui:UiBinder> 